@prefix :     <https://itb.ac.id/a5103/tubes_2#> .
@prefix res:  <https://itb.ac.id/a5103/tubes_2/resource/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://itb.ac.id/a5103/tubes_2> a owl:Ontology ;
    dct:title "Pharmacotherapy and Drug Discovery Ontology (AI5103 Tubes 2)"@en ;
    dct:description "Lean OWL 2 DL ontology integrating DrugCentral, UniProt, and Reactome for pharmacotherapy Knowledge-Graph Question Answering (KGQA)."@en ;
    dct:created "2026-11-21" ;
    owl:versionInfo "2.3.0-lean" .

dct:title a owl:AnnotationProperty .
dct:description a owl:AnnotationProperty .
dct:created a owl:AnnotationProperty .

# =====================================================================================
# 1. CLASSES (20 Classes: 14 Primitive + 6 Defined Classes)
# =====================================================================================

# --- Drug Hierarchy (6) ---

:Drug a owl:Class ;
    rdfs:label "Drug"@en ;
    rdfs:comment "An active pharmaceutical ingredient or therapeutic substance from DrugCentral."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :molecularWeight ;
        owl:allValuesFrom [
            a rdfs:Datatype ;
            owl:onDatatype xsd:double ;
            owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:double ] )
        ]
    ] .

:SmallMoleculeDrug a owl:Class ;
    rdfs:label "Small Molecule Drug"@en ;
    rdfs:comment "A drug automatically classified by the presence of a canonical chemical SMILES structure."@en ;
    rdfs:subClassOf :Drug ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Drug
            [ a owl:Restriction ;
              owl:onProperty :smiles ;
              owl:someValuesFrom xsd:string ]
        )
    ] .

:NonSmallMoleculeDrug a owl:Class ;
    rdfs:label "Non-Small Molecule Drug"@en ;
    rdfs:comment "A biologic or macromolecular drug (e.g., monoclonal antibody) that has no small-molecule SMILES structure."@en ;
    rdfs:subClassOf :Drug ,
        [ a owl:Restriction ;
          owl:onProperty :smiles ;
          owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
          owl:onDataRange xsd:string ] .

:ApprovedDrug a owl:Class ;
    rdfs:label "Approved Drug"@en ;
    rdfs:comment "A drug that has received at least one regulatory approval."@en ;
    rdfs:subClassOf :Drug ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Drug
            [ a owl:Restriction ;
              owl:onProperty :hasApproval ;
              owl:someValuesFrom :RegulatoryApproval ]
        )
    ] .

:HighRiskApprovedDrug a owl:Class ;
    rdfs:label "High-Risk Approved Drug"@en ;
    rdfs:comment "An approved drug that has at least one clinical contraindication and at least one strong FAERS adverse signal (LLR >= 100)."@en ;
    rdfs:subClassOf :ApprovedDrug ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :ApprovedDrug
            [ a owl:Restriction ;
              owl:onProperty :hasAssociation ;
              owl:someValuesFrom :Contraindication ]
            [ a owl:Restriction ;
              owl:onProperty :hasAdverseSignal ;
              owl:someValuesFrom :StrongAdverseSignal ]
        )
    ] .

:RepurposedApprovedDrug a owl:Class ;
    rdfs:label "Repurposed Approved Drug"@en ;
    rdfs:comment "An approved drug that has both an official approved indication and a documented off-label use."@en ;
    rdfs:subClassOf :ApprovedDrug ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :ApprovedDrug
            [ a owl:Restriction ;
              owl:onProperty :hasAssociation ;
              owl:someValuesFrom :Indication ]
            [ a owl:Restriction ;
              owl:onProperty :hasAssociation ;
              owl:someValuesFrom :OffLabelUse ]
        )
    ] .

# --- Clinical & Pharmacovigilance Hierarchy (8) ---

:Disease a owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:comment "A clinical disease, disorder, or medical condition from DrugCentral OMOP concepts."@en .

:DrugDiseaseAssociation a owl:Class ;
    rdfs:label "Drug-Disease Association"@en ;
    rdfs:comment "A reified clinical relationship linking a drug to exactly one disease."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :forDisease ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :Disease
    ] .

:Indication a owl:Class ;
    rdfs:label "Approved Indication"@en ;
    rdfs:comment "An official therapeutic indication for which a drug is approved."@en ;
    rdfs:subClassOf :DrugDiseaseAssociation .

:Contraindication a owl:Class ;
    rdfs:label "Contraindication"@en ;
    rdfs:comment "A clinical condition in which the administration of a drug is prohibited or unsafe."@en ;
    rdfs:subClassOf :DrugDiseaseAssociation .

:OffLabelUse a owl:Class ;
    rdfs:label "Off-Label Use"@en ;
    rdfs:comment "A documented clinical use of a drug outside its officially approved indication."@en ;
    rdfs:subClassOf :DrugDiseaseAssociation .

:AdverseEvent a owl:Class ;
    rdfs:label "Adverse Event"@en ;
    rdfs:comment "A standardized MedDRA adverse drug reaction term."@en .

:AdverseSignal a owl:Class ;
    rdfs:label "Adverse Signal"@en ;
    rdfs:comment "A statistical pharmacovigilance signal linking a drug to exactly one adverse event with a positive LLR score in FAERS."@en ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty :reportsEvent ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :AdverseEvent ],
        [ a owl:Restriction ;
          owl:onProperty :llrScore ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onDataRange xsd:double ],
        [ a owl:Restriction ;
          owl:onProperty :llrScore ;
          owl:allValuesFrom [
              a rdfs:Datatype ;
              owl:onDatatype xsd:double ;
              owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:double ] )
          ] ] .

:StrongAdverseSignal a owl:Class ;
    rdfs:label "Strong Adverse Signal"@en ;
    rdfs:comment "A pharmacovigilance signal with a Log-Likelihood Ratio (LLR) score >= 100.0."@en ;
    rdfs:subClassOf :AdverseSignal ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :AdverseSignal
            [ a owl:Restriction ;
              owl:onProperty :llrScore ;
              owl:someValuesFrom [
                  a rdfs:Datatype ;
                  owl:onDatatype xsd:double ;
                  owl:withRestrictions ( [ xsd:minInclusive "100.0"^^xsd:double ] )
              ]
            ]
        )
    ] .

# --- Regulatory Hierarchy (2) ---

:RegulatoryApproval a owl:Class ;
    rdfs:label "Regulatory Approval"@en ;
    rdfs:comment "A formal marketing authorization granted to a drug by exactly one regulatory agency."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :approvedBy ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :RegulatoryAgency
    ] .

:RegulatoryAgency a owl:Class ;
    rdfs:label "Regulatory Agency"@en ;
    rdfs:comment "A government authority responsible for approving drugs (e.g., FDA, EMA, PMDA)."@en .

# --- Molecular & Pathway Hierarchy (4) ---

:Target a owl:Class ;
    rdfs:label "Pharmacological Target"@en ;
    rdfs:comment "A biological target composed of at least one UniProt protein subunit."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasComponent ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :Protein
    ] .

:ProteinComplexTarget a owl:Class ;
    rdfs:label "Protein Complex Target"@en ;
    rdfs:comment "A pharmacological target composed of at least two distinct protein subunits."@en ;
    rdfs:subClassOf :Target ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Target
            [ a owl:Restriction ;
              owl:onProperty :hasComponent ;
              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
              owl:onClass :Protein ]
        )
    ] .

:Protein a owl:Class ;
    rdfs:label "Protein"@en ;
    rdfs:comment "A protein entity uniquely keyed by its UniProtKB accession."@en ;
    owl:hasKey ( :uniprotAccession ) ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :uniprotAccession ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] .

:Pathway a owl:Class ;
    rdfs:label "Reactome Pathway"@en ;
    rdfs:comment "A human biological pathway from Reactome."@en .

# =====================================================================================
# 2. OBJECT PROPERTIES (10 Properties: 9 Simple + 1 Non-Simple Property Chain)
# =====================================================================================

:hasAssociation a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "has association"@en ;
    rdfs:comment "Links a drug to a unique reified drug-disease clinical association."@en ;
    rdfs:domain :Drug ;
    rdfs:range :DrugDiseaseAssociation .

:forDisease a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "for disease"@en ;
    rdfs:comment "Links a drug-disease association to the single involved disease."@en ;
    rdfs:domain :DrugDiseaseAssociation ;
    rdfs:range :Disease .

:hasApproval a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "has approval"@en ;
    rdfs:comment "Links a drug to a unique regulatory approval record."@en ;
    rdfs:domain :Drug ;
    rdfs:range :RegulatoryApproval .

:approvedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Links a regulatory approval to the single granting agency."@en ;
    rdfs:domain :RegulatoryApproval ;
    rdfs:range :RegulatoryAgency .

:hasAdverseSignal a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "has adverse signal"@en ;
    rdfs:comment "Links a drug to a unique FAERS adverse event signal."@en ;
    rdfs:domain :Drug ;
    rdfs:range :AdverseSignal .

:reportsEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "reports event"@en ;
    rdfs:comment "Links an adverse signal to the single reported MedDRA adverse event."@en ;
    rdfs:domain :AdverseSignal ;
    rdfs:range :AdverseEvent .

:targets a owl:ObjectProperty ;
    rdfs:label "targets"@en ;
    rdfs:comment "Links a drug to its primary pharmacological target (Mechanism of Action)."@en ;
    rdfs:domain :Drug ;
    rdfs:range :Target .

:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "Links a pharmacological target to a constituent UniProt protein."@en ;
    rdfs:domain :Target ;
    rdfs:range :Protein .

:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    rdfs:comment "Links a human protein to a Reactome biological pathway."@en ;
    rdfs:domain :Protein ;
    rdfs:range :Pathway .

:affectsPathway a owl:ObjectProperty ;
    rdfs:label "affects pathway"@en ;
    rdfs:comment "Inferred property chain linking a drug to a human Reactome pathway via its target proteins."@en ;
    rdfs:domain :Drug ;
    rdfs:range :Pathway ;
    owl:propertyChainAxiom ( :targets :hasComponent :participatesIn ) .

# =====================================================================================
# 3. DATATYPE PROPERTIES (5 Properties)
# =====================================================================================

:smiles a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "SMILES"@en ;
    rdfs:comment "Canonical SMILES chemical structure notation of a small-molecule drug."@en ;
    rdfs:domain :Drug ;
    rdfs:range xsd:string .

:molecularWeight a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "molecular weight"@en ;
    rdfs:comment "Molecular weight of a drug in Daltons."@en ;
    rdfs:domain :Drug ;
    rdfs:range xsd:double .

:approvalDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date of regulatory approval formatted as YYYY-MM-DD (stored as xsd:string for HermiT compatibility)."@en ;
    rdfs:domain :RegulatoryApproval ;
    rdfs:range xsd:string .

:llrScore a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "LLR score"@en ;
    rdfs:comment "Log-Likelihood Ratio score measuring FAERS disproportionality signal strength."@en ;
    rdfs:domain :AdverseSignal ;
    rdfs:range xsd:double .

:uniprotAccession a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "UniProt accession"@en ;
    rdfs:comment "Unique UniProtKB accession identifier of a protein."@en ;
    rdfs:domain :Protein ;
    rdfs:range xsd:string .

# =====================================================================================
# 4. DISJOINTNESS AXIOMS
# =====================================================================================

[] a owl:AllDisjointClasses ;
   owl:members ( :Drug :Disease :DrugDiseaseAssociation :AdverseEvent :AdverseSignal :RegulatoryApproval :RegulatoryAgency :Target :Protein :Pathway ) .

[] a owl:AllDisjointClasses ;
   owl:members ( :SmallMoleculeDrug :NonSmallMoleculeDrug ) .

[] a owl:AllDisjointClasses ;
   owl:members ( :Indication :Contraindication :OffLabelUse ) .

